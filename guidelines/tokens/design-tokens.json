        }
      },
      "radius": {
        "xs": 2,
        "sm": 4,
        "button": 4,
        "control": 4,
        "inner": 4,
        "card": 6,
        "overlay": 6,
        "pill": 999
      },
      "layout": {
        "pagePadding": 0,
        "pagePaddingBlock": 0,
        "gridGap": 12,
        "moduleGap": 0
      },
      "control": {
        "tableHeaderHeight": 40,
        "tableRowHeight": 48,
        "switchTrackRadius": 4,
        "switchThumbRadius": 2
      }
    }
  },
  "shared": {
    "typography": {
      "fontFamilySans": "PingFang SC, Noto Sans SC, Microsoft YaHei, sans-serif",
      "fontFamilyMono": "SFMono-Regular, Consolas, Liberation Mono, monospace",
      "fontSize": { "10": 10, "12": 12, "14": 14, "16": 16, "18": 18, "20": 20, "24": 24 },
      "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
      "lineHeight": { "tight": 1.25, "normal": 1.5, "relaxed": 1.7 }
    },
    "spacing": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
    "radius": { "none": 0, "xs": 6, "sm": 8, "button": 8, "control": 10, "inner": 12, "card": 16, "overlay": 16, "pill": 999 },
    "opacity": { "disabled": 0.45, "muted": 0.64, "hover": 0.08, "pressed": 0.14, "overlay": 0.42 },
    "motion": {
      "duration": { "fast": "120ms", "mid": "160ms", "slow": "240ms", "loading": "800ms" },
      "ease": { "in": "cubic-bezier(0.4,0,1,1)", "out": "cubic-bezier(0.16,1,0.3,1)", "inOut": "cubic-bezier(0.2,0,0,1)", "linear": "linear" }
    },
    "zIndex": { "base": 0, "sticky": 20, "dropdown": 50, "drawer": 60, "modal": 70, "modalPopover": 75, "toast": 80, "tooltip": 90 },
    "layout": {
      "contentMaxWidth": 1680,
      "pagePadding": { "desktop": 24, "tablet": 20, "mobile": 16 },
      "gridColumns": { "desktop": 12, "mobile": 4 },
      "gap": { "desktop": 16, "tablet": 12, "mobile": 12 },
      "navigationWidth": { "desktop": 232, "tablet": 208, "mobile": "100%" },
      "sidebarWidth": { "desktop": 292, "tablet": 272, "mobile": "100%" },
      "detailSidebarWidth": { "desktop": 320, "tablet": 300, "mobile": "100%" },
      "productShell": { "navigationWidth": 200, "topbarHeight": 52, "navigationItemHeight": 48, "navigationItemRadius": 12, "navigationIconSize": 18 },
      "breakpoint": { "mobileMax": 767, "tabletMax": 1199, "minimumViewport": 320 }
    },
    "control": {
      "height": { "xs": 24, "sm": 28, "md": 36, "lg": 40 },
      "buttonHeight": { "xs": 24, "sm": 32, "md": 40 },
      "fieldHeight": 40,
      "icon": { "sm": 14, "md": 16 },
      "paddingInline": { "sm": 10, "md": 14 },
      "table": { "headerHeight": 44, "rowHeight": 60, "cellPaddingInline": 16, "actionColumnWidth": 96 },
      "tag": { "smHeight": 20, "mdHeight": 24, "paddingInline": 12 }
    },
    "icon": {
      "source": "项目已批准的系统图标库",
      "style": "线性，统一 24 × 24 viewBox，描边 1.8px",
      "size": { "xs": 12, "sm": 14, "md": 16, "lg": 20, "xl": 24 },
      "color": { "default": "{theme.color.icon}", "inherit": "currentColor", "success": "{theme.color.success}", "warning": "{theme.color.warning}", "danger": "{theme.color.danger}" }
    }
  },
  "state": {
    "hover": { "background": "{theme.color.soft}", "border": "{theme.color.borderStrong}" },
    "pressed": { "background": "color-mix({theme.color.accent} 12%, {theme.color.surface})", "border": "{theme.color.accent}" },
    "selected": { "background": "{theme.color.accentSoft}", "border": "{theme.color.accent}", "text": "{theme.color.accent}" },
    "focus": { "ring": "{theme.color.focus}", "ringWidth": 2, "ringOffset": 2 },
    "disabled": { "background": "{theme.color.soft}", "text": "{theme.color.muted}", "opacity": 0.45 },
    "readonly": { "background": "{theme.color.soft}", "text": "{theme.color.heading}" },
    "error": { "border": "{theme.color.danger}", "ring": "color-mix({theme.color.danger} 28%, transparent)" },
    "success": { "background": "{theme.color.successSoft}", "border": "{theme.color.success}", "text": "{theme.color.successText}" }
  },
  "components": {
    "button": {
      "height": { "xs": 24, "sm": 32, "md": 40 },
      "radius": "{shared.radius.button}",
      "paddingInline": { "xs": 8, "sm": 10, "md": 14 },
      "minWidth": { "xs": 48, "sm": 56, "md": 64 },
      "fontSize": { "xs": 12, "sm": 12, "md": 14 },
      "lineHeight": 1,
      "fontWeight": 600,
      "iconSize": { "xs": 14, "sm": 14, "md": 16 },
      "iconGap": 8,
      "borderWidth": 1,
      "spinner": { "size": 14, "borderWidth": 2 },
      "transition": { "duration": "{shared.motion.duration.mid}", "easing": "{shared.motion.ease.inOut}" },
      "primary": {
        "default": { "background": "{theme.color.brand}", "text": "{theme.color.accentContrast}", "border": "{theme.color.brand}", "icon": "currentColor", "shadow": "0 6px 14px -10px color-mix({theme.color.brand} 60%, transparent)" },
        "hover": { "background": "color-mix({theme.color.brand} 88%, {theme.color.surface})", "text": "{theme.color.accentContrast}", "border": "{theme.color.brand}", "icon": "currentColor", "shadow": "0 8px 18px -12px color-mix({theme.color.brand} 70%, transparent)" },
        "pressed": { "background": "color-mix({theme.color.brand} 76%, #000)", "text": "{theme.color.accentContrast}", "border": "color-mix({theme.color.brand} 76%, #000)", "icon": "currentColor", "shadow": "none" }
      },
      "secondary": {
        "default": { "background": "{theme.color.accentSoft}", "text": "{theme.color.accent}", "border": "transparent", "icon": "currentColor", "shadow": "none" },
        "hover": { "background": "color-mix({theme.color.accentSoft} 76%, {theme.color.surface})", "text": "{theme.color.accent}", "border": "transparent", "icon": "currentColor", "shadow": "none" },
        "pressed": { "background": "{state.pressed.background}", "text": "{theme.color.accent}", "border": "{state.pressed.border}", "icon": "currentColor", "shadow": "none" }
      },
      "danger": {
        "soft": {
          "default": { "background": "{theme.color.dangerSoft}", "text": "{theme.color.dangerText}", "border": "transparent", "icon": "currentColor", "shadow": "none" },
          "hover": { "background": "color-mix({theme.color.danger} 14%, {theme.color.surface})", "text": "{theme.color.dangerText}", "border": "transparent", "icon": "currentColor", "shadow": "none" },
          "pressed": { "background": "color-mix({theme.color.danger} 22%, {theme.color.surface})", "text": "{theme.color.dangerText}", "border": "transparent", "icon": "currentColor", "shadow": "none" }
        },
        "solid": {
          "default": { "background": "{theme.color.danger}", "text": "{theme.color.dangerContrast}", "border": "{theme.color.danger}", "icon": "currentColor", "shadow": "none" },
          "hover": { "background": "color-mix({theme.color.danger} 88%, {theme.color.surface})", "text": "{theme.color.dangerContrast}", "border": "{theme.color.danger}", "icon": "currentColor", "shadow": "none" },
          "pressed": { "background": "color-mix({theme.color.danger} 76%, #000)", "text": "{theme.color.dangerContrast}", "border": "color-mix({theme.color.danger} 76%, #000)", "icon": "currentColor", "shadow": "none" }
        }
      },
      "focus": { "ring": "{state.focus.ring}", "ringWidth": "{state.focus.ringWidth}", "ringOffset": "{state.focus.ringOffset}" },
      "disabled": { "background": "{state.disabled.background}", "text": "{state.disabled.text}", "border": "transparent", "opacity": "{state.disabled.opacity}" },
      "loading": { "cursor": "progress", "preserveWidth": true }
    },
    "input": {
      "height": 40,
      "radius": "{shared.radius.control}",
      "paddingInline": 11,
      "background": "{theme.color.surface}",
      "text": "{theme.color.heading}",
      "placeholder": "{theme.color.muted}",
      "border": "{theme.color.border}",
      "hoverBorder": "{theme.color.borderStrong}",
      "focusBorder": "{theme.color.accent}",
      "errorBorder": "{state.error.border}",
      "readonly": { "background": "{state.readonly.background}", "text": "{state.readonly.text}" }
    },
    "select": {
      "height": 40,
      "radius": "{shared.radius.control}",
      "option": { "hoverBackground": "{state.hover.background}", "pressedBackground": "{state.pressed.background}", "selectedBackground": "{state.selected.background}", "darkSelectedBackground": "color-mix({theme.color.brand} 32%, {theme.color.soft})", "selectedText": "{state.selected.text}", "darkSelectedText": "{theme.color.heading}" }
    },
    "search": { "height": 40, "iconSize": 16, "background": "{theme.color.surface}", "border": "{theme.color.border}", "focusBorder": "{theme.color.accent}" },
    "radio": { "controlSize": 16, "background": "{theme.color.surface}", "border": "{theme.color.borderStrong}", "checked": { "background": "{theme.color.brand}", "indicator": "{theme.color.accentContrast}" } },
    "switch": { "width": 36, "height": 20, "thumbSize": 16, "trackRadius": "{shared.radius.pill}", "thumbRadius": "{shared.radius.pill}", "background": "{theme.color.borderStrong}", "checkedBackground": "{theme.color.brand}", "thumb": "{theme.color.accentContrast}" },
    "number": { "height": 40, "stepperWidth": 28, "border": "{theme.color.border}", "focusBorder": "{theme.color.accent}" },
    "pagination": { "itemSize": 32, "hoverBackground": "{state.hover.background}", "selectedBackground": "{state.selected.background}", "selectedText": "{state.selected.text}" },
    "checkbox": {
      "controlSize": 16,
      "radius": "{shared.radius.xs}",
      "background": "{theme.color.surface}",
      "border": "{theme.color.borderStrong}",
      "checked": { "background": "{theme.color.brand}", "border": "{theme.color.brand}", "indicator": "{theme.color.accentContrast}" },
      "indeterminate": { "background": "{theme.color.brand}", "indicator": "{theme.color.accentContrast}" },
      "disabled": { "background": "{state.disabled.background}", "indicator": "{state.disabled.text}" }
    },
  "table": {
    "headerHeight": 44,
    "rowHeight": 60,
    "headerBackground": "{theme.color.soft}",
    "outerBorder": "{theme.color.border}",
    "headerDivider": "{theme.color.border}",
    "rowDivider": "color-mix(in srgb, {theme.color.border} 68%, transparent)",
    "columnDivider": "transparent",
    "fixedDivider": "{theme.color.borderStrong}",
    "border": "{components.table.outerBorder}",
      "typography": {
        "title": { "fontSize": 16, "fontWeight": 600, "color": "{theme.color.heading}" },
        "header": { "fontSize": 12, "fontWeight": 500, "color": "{theme.color.text}" },
        "cell": { "fontSize": 14, "fontWeight": 400, "color": "{theme.color.text}" },
        "primaryCell": { "fontSize": 14, "fontWeight": 500, "color": "{theme.color.heading}" },
        "secondaryCell": { "fontSize": 12, "fontWeight": 400, "color": "{theme.color.text}" },
        "number": { "fontSize": 14, "fontWeight": 400, "fontVariantNumeric": "tabular-nums", "align": "right" }
      },
      "row": { "hoverBackground": "{state.hover.background}", "pressedBackground": "{state.pressed.background}", "selectedBackground": "{state.selected.background}", "selectedText": "{state.selected.text}" }
    },
    "tabs": { "defaultBackground": "{theme.color.buttonBackground}", "hoverBackground": "{state.hover.background}", "pressedBackground": "{state.pressed.background}", "selectedText": "{state.selected.text}", "indicator": "{theme.color.accent}" },
