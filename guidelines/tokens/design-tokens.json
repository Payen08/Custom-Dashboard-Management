          "signal": { "light": "#E56A17", "dark": "#D46A28" },
          "themeSource": "{stylePresets.industrial.theme}"
        },
        "cobalt": {
          "label": "品牌紫",
          "description": "沿用钢铁蓝工业主题的中性灰白界面，仅将主操作、选中与焦点强调色替换为产品品牌色 #241F7D，并保留橙色设备信号。",
          "signal": { "light": "#E56A17", "dark": "#D46A28" },
