              "color": {
                "page": "#0B0D0E", "layout": "#111416", "surface": "#1D2225", "surfaceRaised": "#292E31", "buttonBackground": "#0F0F11",
                "soft": "#181C1E", "border": "#30363A", "borderStrong": "#454D51",
                "heading": "#F1F3F4", "text": "#BAC1C5", "muted": "#80898E", "icon": "#A8B0B4",
                "brand": "#626B70", "accent": "#C3CBCF", "accentContrast": "#FFFFFF", "accentSoft": "#252A2D", "focus": "#626B70",
                "info": "#76A8BC", "infoSoft": "#182B33", "infoText": "#8FC7FF", "success": "#42C879", "successSoft": "#102A1D", "successText": "#6FDB98",
                "warning": "#E3B341", "warningSoft": "#34270D", "warningText": "#F2C65C", "danger": "#C0392B", "dangerSoft": "#321719", "dangerText": "#FF9696", "dangerContrast": "#FFFFFF",
                "signal": "#E09A3E", "overlay": "rgba(0,0,0,0.72)"
              }
            }
